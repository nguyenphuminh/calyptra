{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false, "verbatimModuleSyntax": true, "isolatedModules": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true, "sourceMap": true
  }
}
