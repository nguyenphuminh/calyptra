  "dependencies": {
    "@libp2p/interface": "^3.3.0",
    "@calyptra/framework": "0.1.0",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  },
  "devDependencies": { "@scure/bip39": "^2.4.0", "@types/express": "^5.0.6" }
}
